generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id       Int    @id @default(autoincrement())
  slug     String @unique
  title    String
  priceRub Int
}

model Order {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  customerName String
  phone        String
  email        String
  address      String
  totalRub     Int
  status       String   @default("new")
  paymentId    String?
}
